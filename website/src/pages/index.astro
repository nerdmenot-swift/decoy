---
/**
 * The landing page, deliberately outside Starlight.
 *
 * Every value shown here was generated by the actual library at build time and read
 * out of src/data/samples.json — nothing on this page is written by hand. That is the
 * whole argument the project makes, so demonstrating it beats asserting it.
 */
import samples from '../data/samples.json'
import lockup from '../components/lockup.svg?raw'

const SEEDS = ['1337', '2024', '7'] as const
const LOCALES: Record<string, string> = {
  en: 'English', de: 'German', fr: 'French', es: 'Spanish', it: 'Italian',
  ja: 'Japanese', ru: 'Russian', pl: 'Polish', tr: 'Turkish', he: 'Hebrew',
  zh_CN: 'Chinese', vi: 'Vietnamese',
}
const fun = samples.fun as Record<string, string[]>

const PLAYGROUND = [
  { key: 'pubName', call: 'whimsy.pubName()', label: 'Pubs' },
  { key: 'beer', call: 'beverage.beer()', label: 'Beers' },
  { key: 'bandName', call: 'whimsy.bandName()', label: 'Bands' },
  { key: 'boardGame', call: 'whimsy.boardGame()', label: 'Board games' },
  { key: 'club', call: 'sport.club()', label: 'Football clubs' },
  { key: 'restaurantName', call: 'whimsy.restaurantName()', label: 'Restaurants' },
  { key: 'superheroName', call: 'whimsy.superheroName()', label: 'Superheroes' },
  { key: 'codename', call: 'whimsy.codename()', label: 'Project codenames' },
  { key: 'talkTitle', call: 'whimsy.talkTitle()', label: 'Conference talks' },
  { key: 'excuse', call: 'whimsy.excuse()', label: 'Incident excuses' },
  { key: 'ssid', call: 'whimsy.ssid()', label: 'Wi-Fi networks' },
  { key: 'databaseError', call: 'system.databaseError()', label: 'Database errors' },
]
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Decoy — seeded fake data for Swift, with provenance</title>
    <meta
      name="description"
      content="Seeded fake data for Swift. Every value traces to a licensed, pinned source — and where it cannot, the corpus says so rather than guessing."
    />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400..700,0..100,0..1&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <script is:inline>
      // Set before paint so the page never flashes the wrong ground.
      const saved = localStorage.getItem('starlight-theme')
      const dark = saved ? saved === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches
      document.documentElement.dataset.theme = dark ? 'dark' : 'light'
    </script>
  </head>

  <body>
    <header class="top">
      <a class="brand" href="/" aria-label="Decoy" set:html={lockup} />
      <nav>
        <a href="/start/install/">Install</a>
        <a href="/ideas/determinism/">Ideas</a>
        <a href="/reference/namespaces/">Reference</a>
        <a href="https://github.com/NerdMeNot/decoy">GitHub</a>
        <button id="theme" type="button" aria-label="Toggle theme">◐</button>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Swift package · Apache-2.0</p>
        <h1>Fake people who<br /><em>came from somewhere</em>.</h1>
        <p class="lede">
          Every faker invents data. Decoy can tell you where each value came from — which
          registry, under which licence, retrieved on which day. And where no registry
          exists, it says so instead of guessing.
        </p>
        <div class="cta">
          <a class="button" href="/start/install/">Get started</a>
          <a class="button ghost" href="/ideas/refusals/">What we refused &rarr;</a>
        </div>
      </section>

      <section class="panel">
        <h2>The same seed, forever</h2>
        <p class="say">
          Fixtures are only useful if they hold still. Pick a seed and you get the same
          rows on every machine, every run, until the corpus version changes — which it
          does loudly, never quietly.
        </p>
        <div class="controls">
          <span class="label">seed</span>
          {SEEDS.map((s, i) => (
            <button class:list={['seed', { on: i === 0 }]} data-seed={s}>{s}</button>
          ))}
          <span class="label locale-label">locale</span>
          <select id="locale">
            {Object.entries(LOCALES).map(([code, name]) => (
              <option value={code}>{name} · {code}</option>
            ))}
          </select>
        </div>
        <div class="table-wrap">
          <table id="rows">
            <thead>
              <tr><th>Name</th><th>City</th><th>Company</th><th>Job</th><th>Phone</th></tr>
            </thead>
            <tbody />
          </table>
        </div>
        <p class="footnote">
          Real output, generated at build time by the library itself. Switch to Chinese or
          Vietnamese and the names turn English — those locales have surnames but no given
          names, and Decoy would rather hand you an obvious fallback than a convincing
          hybrid.
        </p>
      </section>

      <section class="panel">
        <h2>Things that never existed</h2>
        <p class="say">
          Most of the corpus is sourced. Three namespaces are not — they are invented,
          and that is allowed for exactly one reason: there is no fact of the matter. A
          list of real animals can be wrong. <em>The Nimble Jackal</em> cannot.
        </p>
        <div class="chips">
          {PLAYGROUND.map((p, i) => (
            <button class:list={['chip', { on: i === 0 }]} data-key={p.key} data-call={p.call}>
              {p.label}
            </button>
          ))}
        </div>
        <div class="output">
          <code class="call" id="call">faker.whimsy.pubName()</code>
          <ul id="fun" />
        </div>
      </section>

      <section class="panel tight">
        <h2>Where it stops</h2>
        <div class="honest">
          <div>
            <h3>Rosters of real people</h3>
            <p>
              An election-candidate database was offered and declined. It is open, machine
              readable and full of names — and every one identifies a private individual.
            </p>
          </div>
          <div>
            <h3>Corpora with a licence file</h3>
            <p>
              A repository's LICENSE says what its owner grants, not where the data came
              from. One Apache-2.0 name set was built from a 533-million-account breach.
            </p>
          </div>
          <div>
            <h3>Share-alike, laundered</h3>
            <p>
              A CC0 dataset derived from Wikipedia is CC BY-SA wearing a different hat.
              Three known-bad in one small survey is the base rate, not bad luck.
            </p>
          </div>
        </div>
        <a class="button ghost" href="/ideas/refusals/">The whole story &rarr;</a>
      </section>
    </main>

    <footer>
      <span>Apache-2.0 · Swift 6 · Foundation-free core</span>
      <span class="mono">64 locales · 315 generators · 49 sources · 0 faker-js</span>
    </footer>

    <script define:vars={{ samples }}>
      const $ = (s) => document.querySelector(s)
      const state = { seed: '1337', locale: 'en' }

      function paint() {
        const rows = samples.locales[state.locale][state.seed]
        $('#rows tbody').innerHTML = rows
          .map((r) => `<tr><td>${r.name}</td><td>${r.city}</td><td>${r.company}</td>` +
                      `<td>${r.job}</td><td class="mono">${r.phone}</td></tr>`)
          .join('')
      }

      document.querySelectorAll('.seed').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelectorAll('.seed').forEach((o) => o.classList.remove('on'))
          b.classList.add('on')
          state.seed = b.dataset.seed
          paint()
        })
      )
      $('#locale').addEventListener('change', (e) => {
        state.locale = e.target.value
        paint()
      })

      function fun(key, call) {
        $('#call').textContent = `faker.${call}`
        $('#fun').innerHTML = samples.fun[key].map((v) => `<li>${v}</li>`).join('')
      }
      document.querySelectorAll('.chip').forEach((c) =>
        c.addEventListener('click', () => {
          document.querySelectorAll('.chip').forEach((o) => o.classList.remove('on'))
          c.classList.add('on')
          fun(c.dataset.key, c.dataset.call)
        })
      )

      $('#theme').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        localStorage.setItem('starlight-theme', next)
      })

      paint()
      fun('pubName', 'whimsy.pubName()')
    </script>

    <style is:global>
      @import '../styles/theme.css';

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--decoy-paper);
        color: var(--decoy-ink);
        font-family: var(--decoy-sans);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .top {
        display: flex; align-items: center; justify-content: space-between;
        gap: 2rem; padding: 1.1rem clamp(1rem, 5vw, 4rem);
        border-bottom: 1px solid var(--decoy-rule);
        position: sticky; top: 0; z-index: 10;
        background: color-mix(in srgb, var(--decoy-paper) 88%, transparent);
        backdrop-filter: saturate(1.4) blur(8px);
      }
      .brand { display: block; width: 9rem; }
      .brand svg { width: 100%; height: auto; display: block; }
      .top nav { display: flex; align-items: center; gap: 1.4rem; }
      .top nav a {
        color: var(--decoy-muted); text-decoration: none;
        font-size: .92rem; font-weight: 500;
      }
      .top nav a:hover { color: var(--decoy-accent); }
      #theme {
        border: 1px solid var(--decoy-rule); background: transparent;
        color: var(--decoy-muted); border-radius: 2px; cursor: pointer;
        width: 2rem; height: 2rem; font-size: .9rem;
      }

      main {
        max-width: 66rem; margin: 0 auto;
        padding: clamp(2.5rem, 7vw, 5rem) clamp(1rem, 5vw, 4rem) 6rem;
        display: flex; flex-direction: column; gap: clamp(3rem, 8vw, 6rem);
      }

      .eyebrow {
        font-family: var(--decoy-mono); font-size: .72rem; letter-spacing: .14em;
        text-transform: uppercase; color: var(--decoy-faint); margin: 0 0 1.2rem;
      }
      h1 {
        font-family: var(--decoy-display);
        font-variation-settings: 'SOFT' 30, 'WONK' 1;
        font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: 1.03;
        letter-spacing: -.02em; font-weight: 600; margin: 0 0 1.5rem;
      }
      h1 em { font-style: italic; color: var(--decoy-accent); }
      .lede {
        font-size: clamp(1.05rem, 2vw, 1.24rem); color: var(--decoy-muted);
        max-width: 46ch; margin: 0 0 2rem;
      }
      .cta { display: flex; flex-wrap: wrap; gap: .8rem; }
      .button {
        display: inline-block; padding: .62rem 1.1rem; border-radius: 3px;
        background: var(--decoy-accent); color: var(--decoy-paper);
        text-decoration: none; font-weight: 600; font-size: .95rem;
        border: 1px solid var(--decoy-accent);
      }
      .button.ghost { background: transparent; color: var(--decoy-accent); }

      .panel {
        border-top: 2px solid var(--decoy-ink); padding-top: 1.6rem;
        display: flex; flex-direction: column; gap: 1.1rem;
      }
      h2 {
        font-family: var(--decoy-display);
        font-variation-settings: 'SOFT' 20, 'WONK' 1;
        font-size: clamp(1.6rem, 3.4vw, 2.1rem); margin: 0; letter-spacing: -.015em;
      }
      h3 { font-size: .98rem; margin: 0 0 .35rem; font-weight: 650; }
      .say { color: var(--decoy-muted); max-width: 62ch; margin: 0; }
      .footnote { font-size: .86rem; color: var(--decoy-faint); max-width: 62ch; margin: 0; }

      .controls { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
      .label {
        font-family: var(--decoy-mono); font-size: .68rem; letter-spacing: .1em;
        text-transform: uppercase; color: var(--decoy-faint);
      }
      .locale-label { margin-left: 1rem; }
      .seed, .chip {
        font-family: var(--decoy-mono); font-size: .82rem; cursor: pointer;
        padding: .3rem .7rem; border-radius: 2px;
        border: 1px solid var(--decoy-rule); background: var(--decoy-card);
        color: var(--decoy-muted);
      }
      .seed.on, .chip.on {
        background: var(--decoy-accent); border-color: var(--decoy-accent);
        color: var(--decoy-paper); font-weight: 600;
      }
      select {
        font-family: var(--decoy-mono); font-size: .82rem; padding: .3rem .5rem;
        border: 1px solid var(--decoy-rule); border-radius: 2px;
        background: var(--decoy-card); color: var(--decoy-ink);
      }

      .table-wrap {
        overflow-x: auto; border: 1px solid var(--decoy-rule); background: var(--decoy-card);
      }
      table { border-collapse: collapse; width: 100%; font-size: .88rem; min-width: 42rem; }
      th, td { text-align: left; padding: .5rem .8rem; border-bottom: 1px solid var(--decoy-rule); }
      th {
        font-family: var(--decoy-mono); font-size: .66rem; letter-spacing: .1em;
        text-transform: uppercase; color: var(--decoy-faint); font-weight: 500;
      }
      tbody tr:last-child td { border-bottom: 0; }
      .mono { font-family: var(--decoy-mono); font-variant-numeric: tabular-nums; }

      .chips { display: flex; flex-wrap: wrap; gap: .45rem; }
      .output { border: 1px solid var(--decoy-rule); background: var(--decoy-card); }
      .call {
        display: block; font-family: var(--decoy-mono); font-size: .8rem;
        padding: .55rem .9rem; border-bottom: 1px solid var(--decoy-rule);
        color: var(--decoy-accent); background: var(--decoy-accent-soft);
      }
      #fun {
        margin: 0; padding: .6rem .9rem; list-style: none;
        display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
        gap: .25rem .9rem; font-size: .92rem;
      }
      #fun li { padding: .18rem 0; }

      .honest {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 1px; background: var(--decoy-rule);
        border: 1px solid var(--decoy-rule);
      }
      .honest > div { background: var(--decoy-card); padding: 1rem 1.1rem; }
      .honest p { margin: 0; font-size: .88rem; color: var(--decoy-muted); }
      .tight { gap: 1.4rem; align-items: flex-start; }

      footer {
        border-top: 1px solid var(--decoy-rule);
        padding: 1.4rem clamp(1rem, 5vw, 4rem);
        display: flex; flex-wrap: wrap; gap: .6rem 2rem;
        justify-content: space-between;
        font-size: .82rem; color: var(--decoy-faint);
      }
      footer .mono { font-family: var(--decoy-mono); }

      @media (max-width: 40rem) {
        .top nav a:not(:last-of-type) { display: none; }
      }
    </style>
  </body>
</html>
