---
/**
 * The landing page, deliberately outside Starlight.
 *
 * Ordered by what somebody evaluating a fake-data library actually needs: what it is,
 * how to install it, what calling it looks like, and how much of it there is. An earlier
 * draft opened with the register and gave a third of the page to sources that were
 * declined — interesting to the author, useless to anyone who wants a phone number, and
 * it shipped a Swift library whose landing page contained no Swift.
 *
 * Every value shown was generated by the library at build time and read out of
 * src/data/samples.json, provenance included. Nothing here is written by hand.
 */
import samples from '../data/samples.json'
import lockup from '../components/lockup.svg?raw'
import ThemeToggle from '../components/ThemeToggle.astro'
import Select from '../components/Select.astro'
import '../styles/theme.css'
import '../styles/home.css'

const api = samples.api as Record<string, string[]>
const SEEDS = ['1337', '2024', '7'] as const
const LOCALES: Record<string, string> = {
  en: 'English', de: 'German', fr: 'French', es: 'Spanish', it: 'Italian',
  ja: 'Japanese', ru: 'Russian', pl: 'Polish', tr: 'Turkish', he: 'Hebrew',
  zh_CN: 'Chinese', vi: 'Vietnamese',
}
/** The register's columns.
 *
 * `address` earns its place: it is the column that proves the claim underneath the table,
 * because the shape moves rather than the vocabulary — `56 Williams Well` in English,
 * `Mariastellaweg 9` in German, `2丁目19番9号` in Japanese. It was being extracted and
 * then not shown, so the page asserted something it was already holding the evidence for.
 *
 * `job` came out to make room. It is the one column identical in every locale, which is
 * true and worth knowing but is the locale matrix's job, not this table's.
 */
const COLUMNS = ['name', 'address', 'city', 'company', 'phone'] as const

/** Generated values that no source could own, for the section that says so. */
const SPECIMENS: [string, string][] = [
  ['whimsy.pubName', 'pubName'],
  ['whimsy.bandName', 'bandName'],
  ['whimsy.codename', 'codename'],
  ['whimsy.superheroName', 'superheroName'],
  ['beverage.beer', 'beer'],
  ['sport.club', 'club'],
  ['whimsy.ssid', 'ssid'],
  ['whimsy.boardGame', 'boardGame'],
]
const LONG_SPECIMENS: [string, string][] = [
  ['whimsy.talkTitle', 'talkTitle'],
  ['whimsy.technobabble', 'technobabble'],
  ['system.databaseError', 'databaseError'],
]

/** Namespaces, with a line each and the methods worth leading with. */
const NAMESPACES: [string, string, string[]][] = [
  ['person', 'Names, honorifics, jobs', ['fullName', 'firstName', 'jobTitle', 'ssn', 'prefix', 'bloodType']],
  ['location', 'Addresses, cities, postcodes', ['streetAddress', 'city', 'country', 'postcode', 'county', 'timeZone']],
  ['internet', 'Emails, domains, IPs', ['email', 'username', 'url', 'ipv4', 'macAddress', 'password']],
  ['phone', 'Numbers in local format', ['number', 'areaCode', 'imei']],
  ['company', 'Names, forms, buzzwords', ['name', 'legalEntityType', 'catchPhrase', 'buzzPhrase']],
  ['commerce', 'Products, prices, reviews', ['productName', 'price', 'department', 'review', 'ean', 'sku']],
  ['finance', 'IBANs, cards, currencies', ['iban', 'creditCardNumber', 'accountNumber', 'currencyCode', 'transactionDescription']],
  ['instant', 'Dates without Foundation', ['past', 'future', 'birthdate', 'monthName', 'weekdayName']],
  ['date', 'The same, as Foundation.Date', ['past', 'future', 'birthdate']],
  ['system', 'Files, MIME types, errors', ['fileName', 'mimeType', 'semver', 'databaseError', 'httpError', 'filePath']],
  ['database', 'Engines, columns, types', ['engine', 'column', 'type', 'collation']],
  ['crypto', 'Hashes and chain addresses', ['sha256', 'md5', 'ethereumAddress', 'bitcoinAddress']],
  ['lorem', 'Placeholder prose', ['word', 'sentence', 'paragraph', 'slug']],
  ['word', 'Words by part of speech', ['noun', 'verb', 'adjective', 'adverb']],
  ['color', 'Names, hex, RGB', ['human', 'hex', 'rgb', 'space']],
  ['science', 'Elements and SI units', ['chemicalElement', 'unit']],
  ['vehicle', 'Makes, models, plates', ['manufacturer', 'model', 'registrationPlate', 'vin', 'fuel']],
  ['airline', 'Airports, aircraft, seats', ['airport', 'airplane', 'flightNumber', 'seat', 'recordLocator']],
  ['animal', 'Animals, birds, breeds', ['animal', 'bird', 'dogBreed', 'catBreed', 'petName', 'fish']],
  ['food', 'Produce, cheeses, dishes', ['fruit', 'vegetable', 'cheese', 'dish', 'dessert', 'bread']],
  ['nature', 'Peaks, rivers, gemstones', ['mountain', 'river', 'tree', 'flower', 'gemstone', 'weather']],
  ['media', 'Books, films, genres', ['bookTitle', 'bookAuthor', 'filmTitle', 'musicGenre', 'instrument']],
  ['notable', 'Historical figures', ['scientist', 'philosopher', 'composer', 'artist', 'explorer']],
  ['brand', 'Cameras, phones, watches', ['camera', 'phone', 'watch', 'fashion', 'appliance']],
  ['institution', 'Universities, clubs, museums', ['university', 'footballClub', 'museum', 'newspaper']],
  ['whimsy', 'Invented pubs, bands, codenames', ['pubName', 'bandName', 'codename', 'superheroName', 'talkTitle', 'excuse']],
  ['beverage', 'Invented beers and wines', ['beer', 'wine', 'whisky', 'cocktail', 'coffee']],
  ['sport', 'Invented clubs and trophies', ['club', 'venue', 'trophy', 'discipline']],
  ['faker', 'UUIDs and masks', ['uuid', 'uuidV7']],
]

const at = (ns: string, m: string) => api[ns === 'faker' ? m : `${ns}.${m}`]

const cards = NAMESPACES.map(([ns, blurb, methods]) => ({
  ns,
  blurb,
  count: Object.keys(api).filter((k) =>
    ns === 'faker' ? !k.includes('.') : k.startsWith(`${ns}.`)).length,
  preview: methods.slice(0, 3).map((m) => at(ns, m)?.[0]).filter(Boolean),
  methods: methods
    .map((m) => ({ m, values: at(ns, m) ?? [] }))
    .filter((x) => x.values.length),
}))

/** Counts, read out of the build rather than typed.
 *
 * Three different generator totals were live on the site at once — 319 on the reference
 * index, 316 in this page's headline, 315 in the README — because each was written by hand
 * at a different time. The headline had the smallest of them: `Object.keys(api).length`
 * counts only the generators that produced a sample, so every generator taking a required
 * argument was quietly missing from the number.
 *
 * The locale count was wrong for a different reason. Sixty-four `.decoy` files ship, but
 * one is `base` — the language-neutral data every chain ends at, and not a locale anybody
 * can generate a person from. Sixty-three is the number that means something.
 */
const stats = samples.stats as {
  generators: number
  namespaces: number
  sources: number
  locales: number
}
const fun = samples.fun as Record<string, string[]>

/** The rail is two columns, so its row count and any filler follow from the roster size.
 *
 * Both were hardcoded to 15, which happened to be right for 29 namespaces and left one
 * empty cell painted in the divider colour — a visible grey notch in the corner of the
 * grid. Adding a thirtieth namespace would have silently started a third column. */
const railRows = Math.ceil(cards.length / 2)
const railFillers = railRows * 2 - cards.length

/** The hero's example output, read from the same extraction as everything else.
 *
 * These five comments were typed by hand, so they drifted from what the library returns
 * the moment sampling changed — on a page whose claim is that nothing on it is written by
 * hand, in the first code block anybody reads. */
const HERO_CALLS = [
  ['faker.person.fullName()', 'person.fullName'],
  ['faker.location.streetAddress()', 'location.streetAddress'],
  ['faker.company.name()', 'company.name'],
  ['faker.internet.email()', 'internet.email'],
  ['faker.person.jobTitle()', 'person.jobTitle'],
] as const
// The gutter is part of the padding rather than a literal space in the markup: JSX strips
// a space sitting between an expression and the next element, so the longest line — the one
// that sets the column — lost its gap and ran straight into its own comment.
const heroWidth = Math.max(...HERO_CALLS.map(([call]) => call.length)) + 1
const heroLines = HERO_CALLS.map(
  ([call, path]) => [call.padEnd(heroWidth), `// "${api[path]?.[0] ?? ''}"`] as const
)
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Decoy — seeded fake data for Swift</title>
    <meta
      name="description"
      content={`${stats.generators} generators across ${stats.namespaces} namespaces and ${stats.locales} locales. Seeded, so the same number gives the same rows every time — and every value can name the source it came from.`}
    />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      const saved = localStorage.getItem('starlight-theme')
      document.documentElement.dataset.theme =
        saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    </script>
  </head>

  <body>
    <header class="top">
      <a class="top-brand" href="/" aria-label="Decoy" set:html={lockup} />
      <nav class="top-nav">
        <a href="/start/install/">Install</a>
        <a href="/start/cheatsheet/">Cheatsheet</a>
        <a href="/api/">Generators</a>
        <a href="https://github.com/nerdmenot-swift/decoy">GitHub</a>
        <ThemeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-say">
          <p class="doc-label">Swift 6 · Apache-2.0 · no dependencies</p>
          <h1>Fake data you can<br />generate twice.</h1>
          <p class="voice">
            {stats.generators} generators across {stats.namespaces} namespaces and{' '}
            {stats.locales} locales. Pick a number and you get the same people every time —
            on any machine, on any day.
          </p>
          <div class="cta">
            <a class="btn" href="/start/quick-start/">Quick start</a>
            <a class="btn btn-ghost" href="/start/cheatsheet/">Cheatsheet &rarr;</a>
          </div>
        </div>

        <div class="hero-code">
          <div class="code-head">Package.swift</div>
          <pre><code>.package(url: "…/decoy", from: "1.0.0")</code></pre>
          <div class="code-head">Anywhere</div>
          <pre><code><span class="k">import</span> Decoy
<span class="k">import</span> DecoyLocaleEN

<span class="k">var</span> faker = Faker(seed: <span class="n">1337</span>, locale: DecoyLocaleEN.locale)
{'\n'}{heroLines.map(([call, out]) => (
  <Fragment>{call}<span class="c">{out}</span>{'\n'}</Fragment>
))}</code></pre>
        </div>
      </section>

      <!-- The two paragraphs are two columns because they describe the two controls
           directly beneath them: one knob for which people you get, one for what shape
           they take. The locale claim used to trail the table in grey, which put the
           assertion after its own evidence and at the smallest size on the page. -->
      <section class="reg">
        <p class="doc-label">The same number, the same people</p>
        <h2>Two knobs</h2>
        <div class="knobs">
          <p>
            A <strong>seed</strong> is just a number you choose. Decoy's randomness is
            deterministic, so the same number always makes the same choices — seed 1337
            gives you these six people today, next year, on your laptop and in CI. Change
            the number, get a different six. That is what makes generated fixtures safe to
            rely on.
          </p>
          <p>
            A <strong>locale</strong> changes the shape, not just the vocabulary. Watch the
            address column: English puts the number first, German puts it last, Japanese
            uses no spaces at all. Some locales fall back to English for some fields — the{' '}
            <a href="/reference/locale-matrix/">locale matrix</a> says exactly which.
          </p>
        </div>

        <div class="rig">
          <span class="rig-label">seed</span>
          {SEEDS.map((s, i) => (
            <button class:list={['pill', { on: i === 0 }]} data-seed={s}>{s}</button>
          ))}
          <span class="rig-label rig-gap">locale</span>
          <Select
            id="locale"
            label="Locale"
            options={Object.entries(LOCALES).map(([value, label]) => ({ value, label, hint: value }))}
          />
        </div>

        <div class="sheet-wrap">
          <table class="sheet">
            <thead>
              <tr><th class="num">№</th>{COLUMNS.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody id="rows"></tbody>
          </table>
        </div>

        <p class="sheet-hint">
          Click any row — every value can name the licensed source it was drawn from.
        </p>

        <div class="stamp" id="stamp" hidden>
          <span class="stamp-head">where these came from</span>
          <dl id="stamp-body"></dl>
        </div>
      </section>

      <!-- The breadth, which is what somebody evaluating the library is really asking
           about. Every value in every pane was generated during this build. -->
      <section class="reg">
        <p class="doc-label">Everything it generates</p>
        <h2>{stats.generators} generators</h2>
        <p class="voice">
          Pick a namespace to see real output, or open its page for every method it has.
        </p>
        <!-- Two panes rather than a grid of cards over a floating panel. The panel was
             sticky at the top of the viewport while the card that drove it could be most
             of a screen below, so the output changed where nobody was looking; and it grew
             and shrank with each namespace, shunting the whole page. Here the roster sits
             beside its own output at a fixed height, so choosing is a local act and nothing
             below ever moves. -->
        <div class="browser" style={`--rail-rows: ${railRows}`}>
          <div class="rail">
            {cards.map((c, i) => (
              <button
                class:list={['rail-item', { on: i === 0 }]}
                data-ns={c.ns}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <code>{c.ns}</code><span class="rail-n">{c.count}</span>
              </button>
            ))}
            {Array.from({ length: railFillers }, () => (
              <span class="rail-item rail-fill" aria-hidden="true"></span>
            ))}
          </div>
          <div class="pane">
            <div class="pane-head">
              <code id="pane-ns">faker.person</code>
              <span id="pane-blurb">Names, honorifics, jobs</span>
              <a id="pane-link" href="/api/person/">all 17 &rarr;</a>
            </div>
            <dl id="pane-body"></dl>
          </div>
        </div>
      </section>

      <!-- The distinction the rest of the page cannot make: everything above is drawn from
           a licensed source and can name it. These are built from patterns instead,
           so no real pub, band or person is being named. Both are honest; they are honest
           about different things, and the difference is the reason the corpus records
           provenance at all. -->
      <section class="reg reg-invented">
        <p class="doc-label">Invented, not sourced</p>
        <h2>Nobody owns these</h2>
        <p class="voice">
          Some namespaces are assembled from patterns rather than drawn from a real-world
          list, so the output is plausible without belonging to anyone. There is no pub
          called The Gecko &amp; Atlas. That is the point: a fixture, a screenshot or a demo
          can use these without naming a business that has to live with it.
        </p>

        <div class="specimens">
          {SPECIMENS.map(([label, k]) => (
            <div class="spec">
              <code>{label}()</code>
              <ul>{fun[k]?.slice(0, 4).map((v) => <li>{v}</li>)}</ul>
            </div>
          ))}
        </div>
        <div class="specimens specimens-long">
          {LONG_SPECIMENS.map(([label, k]) => (
            <div class="spec">
              <code>{label}()</code>
              <ul>{fun[k]?.slice(0, 2).map((v) => <li>{v}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <section class="reg">
        <div class="ends">
          <a class="end" href="/guides/seeding-a-database/">
            <h3>Seed a database</h3>
            <p>
              A million coherent rows. Rows are independent, so a run splits across tasks
              and resumes after a failure at the row it stopped on.
            </p>
            <span class="end-go">Guide &rarr;</span>
          </a>
          <a class="end" href="/guides/testing/">
            <h3>Use it in tests</h3>
            <p>
              Fixtures that read like real records and never change under you. When one
              fails, the seed in the message reproduces it exactly.
            </p>
            <span class="end-go">Guide &rarr;</span>
          </a>
          <a class="end" href="/guides/forges/">
            <h3>Describe a type once</h3>
            <p>
              <code>Forge</code> maps generators onto your own struct with key paths, and
              carries traits, uniqueness and one-to-many children.
            </p>
            <span class="end-go">Guide &rarr;</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <span>Apache-2.0 · Swift 6 · Foundation-free core</span>
      <span class="tabular">
        {stats.locales} locales · {stats.generators} generators ·{' '}
        {stats.sources} licensed sources
      </span>
    </footer>

    <script define:vars={{ samples, cards, COLS: COLUMNS }}>
      const $ = (s) => document.querySelector(s)
      // COLS comes from the same COLUMNS the <thead> is built from. It used to be a second
      // literal here, so adding `address` to one list moved the heading and left the cells
      // where they were — a table whose columns lie about their contents.
      const state = { seed: '1337', locale: 'en', open: null }
      const esc = (s) =>
        String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c])

      function paint() {
        const rows = samples.locales[state.locale][state.seed]
        $('#rows').innerHTML = rows
          .map((r, i) => {
            const cells = COLS.map(
              (c) => `<td${c === 'phone' ? ' class="tabular"' : ''}>${esc(r[c])}</td>`
            ).join('')
            return `<tr data-row="${i}"><td class="num">${String(i + 1).padStart(3, '0')}</td>${cells}</tr>`
          })
          .join('')
        closeStamp()
      }
      function closeStamp() {
        state.open = null
        $('#stamp').hidden = true
        document.querySelectorAll('#rows tr').forEach((r) => r.classList.remove('picked'))
      }
      $('#rows').addEventListener('click', (e) => {
        const tr = e.target.closest('tr')
        if (!tr) return
        const i = Number(tr.dataset.row)
        if (state.open === i) return closeStamp()
        document.querySelectorAll('#rows tr').forEach((r) => r.classList.remove('picked'))
        tr.classList.add('picked')
        const prov = samples.prov[state.locale]
        $('#stamp-body').innerHTML = COLS.map((c) => {
          const p = prov[c]
          if (!p) return `<div><dt>${c}</dt><dd>—</dd></div>`
          return `<div><dt>${c}</dt><dd><b>${esc(p.source)}</b>` +
            `<span>${esc(p.license)}</span>` +
            `<span>retrieved ${esc(p.retrieved || p.version)}</span></dd></div>`
        }).join('')
        $('#stamp').hidden = false
        state.open = i
      })
      document.querySelectorAll('[data-seed]').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelectorAll('[data-seed]').forEach((o) => o.classList.remove('on'))
          b.classList.add('on')
          state.seed = b.dataset.seed
          paint()
        })
      )
      // The listbox reports its choice on a CustomEvent rather than through .value.
      document.querySelector('[data-select="locale"]').addEventListener('change', (e) => {
        state.locale = e.detail
        paint()
      })

      const byNs = Object.fromEntries(cards.map((c) => [c.ns, c]))
      function showNs(ns) {
        const c = byNs[ns]
        $('#pane-ns').textContent = ns === 'faker' ? 'faker' : `faker.${ns}`
        $('#pane-blurb').textContent = c.blurb
        $('#pane-link').href = `/api/${ns}/`
        $('#pane-link').textContent = `all ${c.count} →`
        $('#pane-body').innerHTML = c.methods
          .map(
            (x) =>
              `<div><dt>${esc(x.m)}()</dt><dd>` +
              x.values.map((v) => `<span>${esc(v)}</span>`).join('') +
              '</dd></div>'
          )
          .join('')
        // The pane scrolls, so a previous namespace's scroll position would otherwise
        // land you halfway down the new one.
        $('#pane-body').scrollTop = 0
      }
      document.querySelectorAll('[data-ns]').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelectorAll('[data-ns]').forEach((o) => {
            o.classList.remove('on')
            o.setAttribute('aria-pressed', 'false')
          })
          b.classList.add('on')
          b.setAttribute('aria-pressed', 'true')
          showNs(b.dataset.ns)
        })
      )


      paint()
      showNs('person')
    </script>

    
  </body>
</html>
