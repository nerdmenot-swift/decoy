---
/**
 * The landing page, deliberately outside Starlight.
 *
 * The hero is the register itself rather than a banner over one. The first draft opened
 * with an eyebrow, a serif headline with a coloured italic, a grey lede and a pair of
 * buttons — the default hero, and it pushed the only genuinely interesting thing on the
 * page below the fold. What this project has that others do not is a table of people who
 * do not exist, each value able to name its source. So the table opens the page.
 *
 * Every value here was generated by the library at build time and read out of
 * src/data/samples.json, provenance included. Nothing on this page is written by hand.
 */
import samples from '../data/samples.json'
import lockup from '../components/lockup.svg?raw'

const SEEDS = ['1337', '2024', '7'] as const
const LOCALES: Record<string, string> = {
  en: 'English', de: 'German', fr: 'French', es: 'Spanish', it: 'Italian',
  ja: 'Japanese', ru: 'Russian', pl: 'Polish', tr: 'Turkish', he: 'Hebrew',
  zh_CN: 'Chinese', vi: 'Vietnamese',
}
const COLUMNS = ['name', 'city', 'company', 'job', 'phone'] as const

const PLAYGROUND = [
  { key: 'pubName', call: 'whimsy.pubName()', label: 'Pubs' },
  { key: 'beer', call: 'beverage.beer()', label: 'Beers' },
  { key: 'bandName', call: 'whimsy.bandName()', label: 'Bands' },
  { key: 'boardGame', call: 'whimsy.boardGame()', label: 'Board games' },
  { key: 'club', call: 'sport.club()', label: 'Football clubs' },
  { key: 'restaurantName', call: 'whimsy.restaurantName()', label: 'Restaurants' },
  { key: 'superheroName', call: 'whimsy.superheroName()', label: 'Superheroes' },
  { key: 'codename', call: 'whimsy.codename()', label: 'Codenames' },
  { key: 'talkTitle', call: 'whimsy.talkTitle()', label: 'Conference talks' },
  { key: 'excuse', call: 'whimsy.excuse()', label: 'Incident excuses' },
  { key: 'ssid', call: 'whimsy.ssid()', label: 'Wi-Fi networks' },
  { key: 'databaseError', call: 'system.databaseError()', label: 'Database errors' },
]
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Decoy — a register of people who do not exist</title>
    <meta
      name="description"
      content="Seeded fake data for Swift. Every value traces to a licensed, pinned source — and where it cannot, the corpus says so rather than guessing."
    />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      const saved = localStorage.getItem('starlight-theme')
      document.documentElement.dataset.theme =
        (saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'))
    </script>
  </head>

  <body>
    <header class="top">
      <a class="top-brand" href="/" aria-label="Decoy" set:html={lockup} />
      <nav class="top-nav">
        <a href="/start/install/">Install</a>
        <a href="/ideas/provenance/">Ideas</a>
        <a href="/reference/namespaces/">Reference</a>
        <a href="https://github.com/NerdMeNot/decoy">GitHub</a>
        <button id="theme" type="button" aria-label="Switch theme">◐</button>
      </nav>
    </header>

    <main>
      <!-- The register. Not a demo of the product; the product's output, first thing. -->
      <section class="reg">
        <p class="doc-label">Register of persons not on record</p>
        <h1>A register of people<br />who do not exist.</h1>
        <p class="voice">
          Seeded fake data for Swift. Every row below was generated by the library itself
          — and every column can tell you which registry it came from, under which
          licence, retrieved on which day.
        </p>

        <div class="rig">
          <span class="rig-label">seed</span>
          {SEEDS.map((s, i) => (
            <button class:list={['pill', { on: i === 0 }]} data-seed={s}>{s}</button>
          ))}
          <span class="rig-label rig-gap">locale</span>
          <select id="locale">
            {Object.entries(LOCALES).map(([code, name]) => (
              <option value={code}>{name} · {code}</option>
            ))}
          </select>
          <span class="rig-hint">click any row for provenance</span>
        </div>

        <div class="sheet-wrap">
          <table class="sheet">
            <thead>
              <tr>
                <th class="num">№</th>
                {COLUMNS.map((c) => <th>{c}</th>)}
              </tr>
            </thead>
            <tbody id="rows" />
          </table>
        </div>

        <!-- The signature: real provenance, read out of the corpus at build time. -->
        <div class="stamp" id="stamp" hidden>
          <span class="stamp-head">provenance</span>
          <dl id="stamp-body" />
        </div>

        <p class="caption">
          Switch to Chinese or Vietnamese and the names turn English. Those locales carry
          their own surnames but no given names, and Decoy would rather hand you an
          obvious fallback than a convincing hybrid.
        </p>

        <div class="cta">
          <a class="btn" href="/start/install/">Install it</a>
          <a class="btn btn-ghost" href="/ideas/refusals/">What we refused &rarr;</a>
        </div>
      </section>

      <section class="reg">
        <p class="doc-label">Invented, not sourced</p>
        <h2>Things that never existed</h2>
        <p class="voice">
          Three namespaces are invented, permitted by one test: <em>is there a fact of the
          matter that could be wrong?</em> A list of real animals can be wrong. <em>The
          Nimble Jackal</em> cannot.
        </p>
        <div class="chips">
          {PLAYGROUND.map((p, i) => (
            <button class:list={['pill', { on: i === 0 }]} data-key={p.key} data-call={p.call}>
              {p.label}
            </button>
          ))}
        </div>
        <div class="sheet-wrap">
          <code class="call" id="call">faker.whimsy.pubName()</code>
          <ul class="fun" id="fun" />
        </div>
        <p class="caption">
          337 authored words and 73 patterns yield 257,484 distinct values — measured by
          drawing each generator five million times, which for a space that size exhausts
          it rather than samples it.
        </p>
      </section>

      <section class="reg">
        <p class="doc-label">Declined</p>
        <h2>Where it stops</h2>
        <dl class="ledger">
          <div>
            <dt>Rosters of real people</dt>
            <dd>
              An election-candidate database was offered and declined. Open, machine
              readable, full of names — and every one identifies a private individual.
            </dd>
          </div>
          <div>
            <dt>Corpora with a licence file</dt>
            <dd>
              A repository's LICENSE says what its owner grants, not where the data came
              from. One Apache-2.0 name set was built from a 533-million-account breach.
            </dd>
          </div>
          <div>
            <dt>Share-alike, laundered</dt>
            <dd>
              A CC0 dataset derived from Wikipedia is CC BY-SA wearing a different hat.
              Three known-bad in one small survey is the base rate, not bad luck.
            </dd>
          </div>
          <div>
            <dt>Twelve locales</dt>
            <dd>
              Removed rather than shipped nameless. Tamil carried 15,612 native values and
              still could not name a person.
            </dd>
          </div>
        </dl>
      </section>
    </main>

    <footer>
      <span>Apache-2.0 · Swift 6 · Foundation-free core</span>
      <span class="tabular">64 locales · 315 generators · 49 pinned sources</span>
    </footer>

    <script define:vars={{ samples }}>
      const $ = (s) => document.querySelector(s)
      const COLS = ['name', 'city', 'company', 'job', 'phone']
      const state = { seed: '1337', locale: 'en', open: null }

      const esc = (s) =>
        String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c])

      function paint() {
        const rows = samples.locales[state.locale][state.seed]
        $('#rows').innerHTML = rows
          .map((r, i) => {
            const cells = COLS.map(
              (c) => `<td${c === 'phone' ? ' class="tabular"' : ''}>${esc(r[c])}</td>`
            ).join('')
            return `<tr data-row="${i}"><td class="num">${String(i + 1).padStart(3, '0')}</td>${cells}</tr>`
          })
          .join('')
        closeStamp()
      }

      function closeStamp() {
        state.open = null
        $('#stamp').hidden = true
        document.querySelectorAll('#rows tr').forEach((r) => r.classList.remove('picked'))
      }

      function openStamp(i) {
        const prov = samples.prov[state.locale]
        $('#stamp-body').innerHTML = COLS.map((c) => {
          const p = prov[c]
          if (!p) return `<div><dt>${c}</dt><dd>—</dd></div>`
          return `<div><dt>${c}</dt><dd><b>${esc(p.source)}</b>` +
                 `<span>${esc(p.license)}</span>` +
                 `<span>retrieved ${esc(p.retrieved || p.version)}</span>` +
                 `<code>${esc(p.path)}</code></dd></div>`
        }).join('')
        $('#stamp').hidden = false
        state.open = i
      }

      $('#rows').addEventListener('click', (e) => {
        const tr = e.target.closest('tr')
        if (!tr) return
        const i = Number(tr.dataset.row)
        if (state.open === i) return closeStamp()
        document.querySelectorAll('#rows tr').forEach((r) => r.classList.remove('picked'))
        tr.classList.add('picked')
        openStamp(i)
      })

      document.querySelectorAll('[data-seed]').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelectorAll('[data-seed]').forEach((o) => o.classList.remove('on'))
          b.classList.add('on')
          state.seed = b.dataset.seed
          paint()
        })
      )
      $('#locale').addEventListener('change', (e) => {
        state.locale = e.target.value
        paint()
      })

      function fun(key, call) {
        $('#call').textContent = `faker.${call}`
        $('#fun').innerHTML = samples.fun[key].map((v) => `<li>${esc(v)}</li>`).join('')
      }
      document.querySelectorAll('[data-key]').forEach((c) =>
        c.addEventListener('click', () => {
          document.querySelectorAll('[data-key]').forEach((o) => o.classList.remove('on'))
          c.classList.add('on')
          fun(c.dataset.key, c.dataset.call)
        })
      )

      $('#theme').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        localStorage.setItem('starlight-theme', next)
      })

      paint()
      fun('pubName', 'whimsy.pubName()')
    </script>

    <style is:global>
      @import '../styles/theme.css';

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--decoy-paper);
        color: var(--decoy-ink);
        font-family: var(--decoy-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* ---- chrome ---- */
      .top {
        display: flex; align-items: center; justify-content: space-between; gap: 2rem;
        padding: 1rem clamp(1rem, 5vw, 3.5rem);
        border-bottom: 1px solid var(--decoy-rule);
        position: sticky; top: 0; z-index: 10;
        background: color-mix(in srgb, var(--decoy-paper) 90%, transparent);
        backdrop-filter: saturate(1.4) blur(8px);
      }
      .top-brand { display: block; width: 8.5rem; }
      .top-brand svg { width: 100%; height: auto; display: block; }
      .top-nav { display: flex; align-items: center; gap: 1.3rem; }
      .top-nav a {
        color: var(--decoy-muted); text-decoration: none;
        font-size: .88rem; font-weight: 500;
      }
      .top-nav a:hover { color: var(--decoy-accent); }
      #theme {
        border: 1px solid var(--decoy-rule); background: transparent;
        color: var(--decoy-muted); border-radius: 2px; cursor: pointer;
        width: 2rem; height: 2rem;
      }

      main {
        max-width: 72rem; margin: 0 auto;
        padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3.5rem) 5rem;
        display: flex; flex-direction: column; gap: clamp(3rem, 7vw, 5rem);
      }

      /* ---- a section reads as a sheet in a file ---- */
      .reg { display: flex; flex-direction: column; gap: 1rem; }
      .doc-label {
        font-family: var(--decoy-mono); font-size: .68rem; font-weight: 500;
        letter-spacing: .16em; text-transform: uppercase; color: var(--decoy-faint);
        margin: 0; padding-bottom: .55rem;
        border-bottom: 1px solid var(--decoy-rule);
      }

      /* The record is typed, not typeset — mono carries the headings, the sans only
         speaks. Dropping the display serif is what stops this reading as every other
         documentation landing page. */
      .reg h1, .reg h2 {
        font-family: var(--decoy-mono); font-weight: 600;
        letter-spacing: -.03em; line-height: 1.08; margin: .2rem 0 0;
      }
      .reg h1 { font-size: clamp(1.9rem, 4.4vw, 3.1rem); }
      .reg h2 { font-size: clamp(1.35rem, 2.6vw, 1.9rem); }

      .voice { margin: 0; color: var(--decoy-muted); max-width: 58ch; font-size: 1rem; }
      .voice em { color: var(--decoy-ink); font-style: italic; }
      .caption {
        margin: 0; font-size: .85rem; color: var(--decoy-faint); max-width: 62ch;
      }

      /* ---- controls ---- */
      .rig { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
      .rig-label {
        font-family: var(--decoy-mono); font-size: .66rem; letter-spacing: .14em;
        text-transform: uppercase; color: var(--decoy-faint);
      }
      .rig-gap { margin-left: .9rem; }
      .rig-hint {
        font-size: .76rem; color: var(--decoy-faint); margin-left: auto;
        font-style: italic;
      }
      .pill {
        font-family: var(--decoy-mono); font-size: .78rem; cursor: pointer;
        padding: .28rem .65rem; border-radius: 2px;
        border: 1px solid var(--decoy-rule); background: transparent;
        color: var(--decoy-muted); transition: none;
      }
      .pill:hover { border-color: var(--decoy-accent); color: var(--decoy-accent); }
      .pill.on {
        background: var(--decoy-ink); border-color: var(--decoy-ink);
        color: var(--decoy-paper); font-weight: 600;
      }
      #locale {
        font-family: var(--decoy-mono); font-size: .78rem; padding: .26rem .5rem;
        border: 1px solid var(--decoy-rule); border-radius: 2px;
        background: transparent; color: var(--decoy-ink);
      }

      /* ---- the sheet ---- */
      .sheet-wrap {
        overflow-x: auto; border: 1px solid var(--decoy-rule);
        background: var(--decoy-card);
      }
      .sheet { border-collapse: collapse; width: 100%; min-width: 46rem; font-size: .88rem; }
      .sheet th, .sheet td {
        text-align: left; padding: .46rem .8rem;
        border-bottom: 1px solid var(--decoy-rule);
      }
      .sheet thead th {
        font-family: var(--decoy-mono); font-size: .64rem; font-weight: 500;
        letter-spacing: .14em; text-transform: uppercase; color: var(--decoy-faint);
        background: var(--decoy-band);
      }
      /* Green-bar paper: the alternating band is what makes it read as a ledger
         rather than as a bootstrap table. */
      .sheet tbody tr:nth-child(even) { background: var(--decoy-band); }
      .sheet tbody tr { cursor: pointer; }
      .sheet tbody tr:hover { background: var(--decoy-accent-soft); }
      .sheet tbody tr.picked {
        background: var(--decoy-accent-soft);
        box-shadow: inset 3px 0 0 var(--decoy-amber);
      }
      .sheet tbody tr:last-child td { border-bottom: 0; }
      .num {
        font-family: var(--decoy-mono); font-size: .74rem; color: var(--decoy-faint);
        width: 1%; white-space: nowrap;
      }
      .tabular { font-family: var(--decoy-mono); font-variant-numeric: tabular-nums; }

      /* ---- the provenance stamp: the one place amber is allowed ---- */
      .stamp {
        border: 1px solid var(--decoy-amber);
        border-left-width: 3px;
        background: var(--decoy-amber-soft);
        padding: .7rem .9rem;
      }
      .stamp-head {
        font-family: var(--decoy-mono); font-size: .64rem; letter-spacing: .18em;
        text-transform: uppercase; color: var(--decoy-caution); font-weight: 600;
      }
      .stamp dl, #stamp-body {
        margin: .5rem 0 0; display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: .7rem 1.2rem;
      }
      .stamp dt {
        font-family: var(--decoy-mono); font-size: .64rem; letter-spacing: .12em;
        text-transform: uppercase; color: var(--decoy-faint); margin-bottom: .15rem;
      }
      .stamp dd { margin: 0; display: flex; flex-direction: column; font-size: .8rem; }
      .stamp dd b { font-weight: 600; }
      .stamp dd span { color: var(--decoy-muted); }
      .stamp dd code {
        font-family: var(--decoy-mono); font-size: .7rem; color: var(--decoy-faint);
        margin-top: .1rem;
      }

      /* ---- playground ---- */
      .chips { display: flex; flex-wrap: wrap; gap: .35rem; }
      .call {
        display: block; font-family: var(--decoy-mono); font-size: .78rem;
        padding: .5rem .8rem; border-bottom: 1px solid var(--decoy-rule);
        color: var(--decoy-accent); background: var(--decoy-band);
      }
      .fun {
        margin: 0; padding: .55rem .8rem; list-style: none;
        display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
        gap: .1rem .9rem; font-size: .9rem;
      }
      .fun li { padding: .16rem 0; }

      /* ---- declined ---- */
      .ledger {
        margin: 0; display: grid;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        gap: 1px; background: var(--decoy-rule);
        border: 1px solid var(--decoy-rule);
      }
      .ledger > div { background: var(--decoy-card); padding: .9rem 1rem; }
      .ledger dt { font-weight: 650; font-size: .95rem; margin-bottom: .25rem; }
      .ledger dd { margin: 0; font-size: .86rem; color: var(--decoy-muted); }

      /* ---- calls to action ---- */
      .cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .3rem; }
      .btn {
        display: inline-block; padding: .55rem 1rem; border-radius: 2px;
        background: var(--decoy-ink); color: var(--decoy-paper);
        border: 1px solid var(--decoy-ink);
        text-decoration: none; font-weight: 600; font-size: .9rem;
      }
      .btn-ghost {
        background: transparent; color: var(--decoy-accent);
        border-color: var(--decoy-rule);
      }

      footer {
        border-top: 1px solid var(--decoy-rule);
        padding: 1.2rem clamp(1rem, 5vw, 3.5rem);
        display: flex; flex-wrap: wrap; gap: .5rem 2rem; justify-content: space-between;
        font-size: .8rem; color: var(--decoy-faint);
      }

      :focus-visible { outline: 2px solid var(--decoy-accent); outline-offset: 2px; }

      @media (max-width: 46rem) {
        .top-nav a:not(:last-of-type) { display: none; }
        .rig-hint { display: none; }
      }
    </style>
  </body>
</html>
